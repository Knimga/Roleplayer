# Copy this file to .env and fill in real values. .env is gitignored.

# Matches the shared monorepo postgres service (see /docker-compose.yml at
# the repo root) locally, authenticating as this app's own scoped Postgres
# role (cyberpunk_red_app, confined to the cyberpunk_red schema — see
# /infra/postgres/init/01-schemas-and-roles.sql). Render provides its own
# managed Postgres connection string in production.
DATABASE_URL=postgres://cyberpunk_red_app:dev_cyberpunk_pw@localhost:5434/roleplayer

# Own port + client origin so this server can run alongside laria5e's
# (3001/5173) at the same time during dev. Both default to the laria5e
# values if unset, so this app needs them set explicitly; laria5e doesn't.
PORT=3002
CLIENT_ORIGIN=http://localhost:5174

# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model defaults to Sonnet locally (NODE_ENV unset) and Opus in
# production (Render sets NODE_ENV=production) — see server/lib/claude.js.
# Set this to override either default, e.g. to test Opus locally.
ANTHROPIC_MODEL=

# The two fixed user slots. Exactly one of the two *_ADMIN flags should be "true".
USER_A_CODE=
USER_A_USERNAME=
USER_A_ADMIN=true

USER_B_CODE=
USER_B_USERNAME=
USER_B_ADMIN=false

# Used to sign session cookies. Any long random string; generate a real one
# for production (e.g. `openssl rand -hex 32`) — don't reuse the dev value.
SESSION_SECRET=

# Optional: per-player Discord webhook URL + Discord user ID for
# cross-timezone "check the app" pings. Fires whenever one player causes a
# new-message event — only the OTHER player's webhook is called, and their
# user ID is @-mentioned in it, never the actor's own. Leave blank to
# disable for that player. Also gated by a master on/off toggle in the
# in-app admin Settings modal (persisted in Postgres, not an env var) —
# defaults OFF until an admin turns it on.
USER_A_DISCORD_WEBHOOK_URL=
USER_A_DISCORD_USER_ID=
USER_B_DISCORD_WEBHOOK_URL=
USER_B_DISCORD_USER_ID=

# Optional: the link appended to every Discord notification above (see
# server/lib/discordNotify.js). Defaults to the production Render URL if
# unset — fine for prod, but set this to http://localhost:5174 (this app's
# client port) for local testing so the link actually resolves.
APP_URL=
