# Copy this file to .env and fill in real values. .env is gitignored.

# Matches docker-compose.yml's postgres service locally; Render provides
# its own managed Postgres connection string in production.
DATABASE_URL=postgres://dev:dev@localhost:5432/cyberpunk_red_rp

# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# The two fixed user slots. Exactly one of the two *_ADMIN flags should be "true".
USER_A_CODE=
USER_A_USERNAME=
USER_A_ADMIN=true

USER_B_CODE=
USER_B_USERNAME=
USER_B_ADMIN=false

# Used to sign session cookies. Any long random string; generate a real one
# for production (e.g. `openssl rand -hex 32`) — don't reuse the dev value.
SESSION_SECRET=

# Optional: per-player Discord webhook URL + Discord user ID for
# cross-timezone "check the app" pings. Fires whenever one player causes a
# new-message event — only the OTHER player's webhook is called, and their
# user ID is @-mentioned in it, never the actor's own. Leave blank to
# disable for that player. Also gated by a master on/off toggle in the
# in-app admin Settings modal (persisted in Postgres, not an env var).
USER_A_DISCORD_WEBHOOK_URL=
USER_A_DISCORD_USER_ID=
USER_B_DISCORD_WEBHOOK_URL=
USER_B_DISCORD_USER_ID=
